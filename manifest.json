{
  "manifest_version": 3,
  "name": "Tab Search",
  "version": "1.0.0",
  "description": "Fuzzy search for tabs in Firefox Browsers with a modern omnibar overlay",
  "permissions": [
    "tabs",
    "tabGroups"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "show-omnibar": {
      "suggested_key": {
        "default": "Ctrl+Space",
        "mac": "Command+Space"
      },
      "description": "Open tab search omnibar"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/default-favicon.svg"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "tab-search@github.com",
      "strict_min_version": "140.0",
      "update_url": "https://raw.githubusercontent.com/nicolaefilat/Tab-Search/refs/heads/main/updates.json",
      "data_collection_permissions": [
        "none required"
      ]
    }
  },
  "icons": {
    "48": "icons/icon-512.png",
    "96": "icons/icon-512.png"
  }
}